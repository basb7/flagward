# =============================================================================
# Flagward Configuration
# =============================================================================
# Copy this file to .env and update the values.
#
# A commented-out line means the application's own default applies. Leaving a
# variable UNCOMMENTED but empty is not the same thing: EMAIL_PORT= makes
# settings fail to import and the app will not boot. Comment it or set it.

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True

# -----------------------------------------------------------------------------
# Edition
# -----------------------------------------------------------------------------
# The plan a new organization is created on, and the only difference between a
# self-hosted install and a hosted one. The code is identical.
#
#   COMMUNITY  unlimited projects and seats. The default, and what an operator
#              running this themselves should stay on.
#   FREE       1 project, 3 seats
#   STARTER    10 projects, 5 seats
#   TEAM       unlimited projects, 25 seats
#
# How many organizations somebody creates is never limited: an empty one holds
# no projects, no flags and no traffic. Flags, environments, conditions and
# rules are never limited either.
#
# The ceilings live in tenancy/capabilities.py and are deliberately readable:
# knowing that FREE allows one project does not let anyone create a second,
# because the check runs against your database on your server.
# DEFAULT_ORGANIZATION_PLAN=FREE

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The engine is chosen by whether these are set, not by a switch of its own:
# with DB_NAME (or USE_POSTGRES) present the app uses PostgreSQL, and with
# neither it falls back to a SQLite file at db.sqlite3.
#
# That fallback is why the app runs with no configuration at all, and also why
# it is worth knowing about: SQLite is not what CI or a deployment runs, so a
# migration or a query that behaves differently there will not show up locally.
# The suite has a test that only runs against PostgreSQL for exactly that
# reason.
#
# The values below match compose.dev.yml, so they work as-is against
# `docker compose -f compose.dev.yml up db`. Uncomment to leave SQLite behind.
# DB_NAME=flagward
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis (optional)
# -----------------------------------------------------------------------------
# REDIS_URL backs the cache. Unset, Django uses an in-process cache, which is
# correct for a single development server and wrong for more than one process:
# each would hold its own copy and they would disagree.
# REDIS_URL=redis://localhost:6379/0

# REDIS_STREAMS_URL backs the flag-change stream that reaches connected SDKs.
# Unset, flags still evaluate and the dashboard still works -- what stops is
# live propagation, so a change reaches a client on its next full read rather
# than within the second.
# REDIS_STREAMS_URL=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Hosts and origins (comma-separated, defaults to localhost for dev)
# -----------------------------------------------------------------------------
# ALLOWED_HOSTS takes hostnames WITHOUT a scheme: it is matched against the
# Host header. The *_ORIGINS settings take full origins WITH the scheme.
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Compiled into the client bundle at build time, so changing it requires
# `docker compose build frontend`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where password-reset and invitation links point. Not derived from
# CORS_ALLOWED_ORIGINS: that lists every permitted origin, not which one is
# the frontend.
#
# Left commented, it defaults to http://localhost:3000, which is right for
# development. SET IT IN PRODUCTION -- otherwise every reset link and every
# invitation you send points at localhost, which the recipient reads as a
# broken product rather than a missing setting.
# FRONTEND_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Superuser (created automatically on first run)
# -----------------------------------------------------------------------------
# This is a real, working login. Change the password before exposing the
# instance: it is an operations account with full Django admin access.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# -----------------------------------------------------------------------------
# Email / SMTP (optional)
# -----------------------------------------------------------------------------
# The app runs fine with none of this set.
#
#   no EMAIL_HOST + DEBUG=True   -> messages print to the backend's terminal,
#                                   so password reset is fully usable in dev
#   no EMAIL_HOST + DEBUG=False  -> messages are discarded, and the UI hides
#                                   the "forgot password" link rather than
#                                   offering a form that sends nothing
#
# Set EMAIL_HOST to switch to real SMTP. Comment these out rather than leaving
# any of them empty.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-domain.com