# =============================================================================
# Flagward Configuration
# =============================================================================
# Copy this file to .env and update the values.
#
# A commented-out line means the application's own default applies. Leaving a
# variable UNCOMMENTED but empty is not the same thing: EMAIL_PORT= makes
# settings fail to import and the app will not boot. Comment it or set it.

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True

# -----------------------------------------------------------------------------
# Hosts and origins (comma-separated, defaults to localhost for dev)
# -----------------------------------------------------------------------------
# ALLOWED_HOSTS takes hostnames WITHOUT a scheme: it is matched against the
# Host header. The *_ORIGINS settings take full origins WITH the scheme.
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Compiled into the client bundle at build time, so changing it requires
# `docker compose build frontend`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where password-reset and invitation links point. Not derived from
# CORS_ALLOWED_ORIGINS: that lists every permitted origin, not which one is
# the frontend.
#
# Left commented, it defaults to http://localhost:3000, which is right for
# development. SET IT IN PRODUCTION -- otherwise every reset link and every
# invitation you send points at localhost, which the recipient reads as a
# broken product rather than a missing setting.
# FRONTEND_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Superuser (created automatically on first run)
# -----------------------------------------------------------------------------
# This is a real, working login. Change the password before exposing the
# instance: it is an operations account with full Django admin access.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# -----------------------------------------------------------------------------
# Email / SMTP (optional)
# -----------------------------------------------------------------------------
# The app runs fine with none of this set.
#
#   no EMAIL_HOST + DEBUG=True   -> messages print to the backend's terminal,
#                                   so password reset is fully usable in dev
#   no EMAIL_HOST + DEBUG=False  -> messages are discarded, and the UI hides
#                                   the "forgot password" link rather than
#                                   offering a form that sends nothing
#
# Set EMAIL_HOST to switch to real SMTP. Comment these out rather than leaving
# any of them empty.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-domain.com